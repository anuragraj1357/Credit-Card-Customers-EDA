Basic EDA
import pandas as pd, numpy as np
import matplotlib.pyplot as plt, seaborn as sns
import sqlite3

df = pd.read_csv("/kaggle/input/credit-card-customers/BankChurners.csv")

# Drop the ID and the 2 leftover Naive Bayes columns (not real features)
df = df.drop(columns=[c for c in df.columns if "Naive_Bayes" in c] + ["CLIENTNUM"])

print(df.shape)
print(df.isnull().sum().sum(), "missing values |", df.duplicated().sum(), "duplicates")
print(df.describe().T)

# Churn flag: 1 = Attrited, 0 = Existing
df["Churn"] = (df["Attrition_Flag"] == "Attrited Customer").astype(int)
print("Overall churn rate: %.2f%%" % (df["Churn"].mean() * 100))

# Distribution + correlation
df["Churn"].value_counts().plot(kind="bar", title="Churn Distribution")
plt.show()
sns.heatmap(df.select_dtypes("number").corr(), cmap="coolwarm", center=0)
plt.show()

Trend Question 1
df["Txn_Band"] = pd.qcut(df["Total_Trans_Ct"], 4,
                         labels=["Low", "Medium", "High", "Very High"])
q1 = df.groupby("Txn_Band", observed=True)["Churn"].mean().mul(100).round(2)
print(q1)
q1.plot(kind="bar", title="Churn % by Transaction Count Quartile")
plt.show()

Trend Question 2 
q2 = df.groupby("Months_Inactive_12_mon")["Churn"].agg(["mean", "count"])
q2["mean"] = (q2["mean"] * 100).round(2)
print(q2)
q2["mean"].plot(marker="o", title="Churn % vs Months Inactive (last 12 months)")
plt.show()
